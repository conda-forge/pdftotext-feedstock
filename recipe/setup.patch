From b4c14d1d8d59ad1aae826587c2ca8a9af6bc69a8 Mon Sep 17 00:00:00 2001
From: Jan Janssen <jan-janssen@users.noreply.github.com>
Date: Sat, 11 Jul 2026 16:49:37 +0200
Subject: [PATCH] Comment out include and library directories

Comment out include and library directories for pdftotext.
---
 pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 8730473..3a1d297 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -20,6 +20,6 @@ build-backend = "setuptools.build_meta"
 name = "pdftotext"
 sources = ["pdftotext.cpp"]
 libraries = ["poppler-cpp"]
-include-dirs = ["/opt/homebrew/include", "/usr/local/include"]
-library-dirs = ["/opt/homebrew/lib", "/usr/local/lib"]
+# include-dirs = ["/opt/homebrew/include", "/usr/local/include"]
+# library-dirs = ["/opt/homebrew/lib", "/usr/local/lib"]
 extra-compile-args = ["-std=c++11", "-Wall"]
